{
  "name": "barefeast",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "build": "npm run clean && next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test:openrouter": "tsx --env-file=.env.local scripts/test-openrouter.ts",
    "test:schemas": "tsx scripts/test-schemas.ts",
    "generate:chef-portraits": "tsx --env-file=.env.local scripts/generate-chef-portraits.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.9",
    "drizzle-orm": "^0.44.2",
    "framer-motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "next": "^15.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
